<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <application>
        <!-- Exported so system UI, Bluetooth and (later) Android Auto controllers can bind;
             MediaSession checks each controller in onConnect. -->
        <service
            android:name="app.rev.playback.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaLibraryService" />
                <action android:name="androidx.media3.session.MediaSessionService" />
                <!-- Android Auto and other legacy media browsers. -->
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <!-- Artwork for Android Auto browse lists (read-only, artwork ids only). -->
        <provider
            android:name="app.rev.playback.ArtworkProvider"
            android:authorities="app.rev.artwork"
            android:exported="true"
            tools:ignore="ExportedContentProvider" />

        <!-- Home-screen "now playing" widget. -->
        <receiver
            android:name="app.rev.playback.widget.NowPlayingWidgetReceiver"
            android:exported="true"
            android:label="REV">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/now_playing_widget" />
        </receiver>

        <!-- Google Cast: the standard Default Media Receiver plays REV's signed stream URLs. -->
        <meta-data
            android:name="com.google.android.gms.cast.framework.OPTIONS_PROVIDER_CLASS_NAME"
            android:value="androidx.media3.cast.DefaultCastOptionsProvider" />

        <!-- Declares REV as a media app for Android Auto. -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />
    </application>
</manifest>
