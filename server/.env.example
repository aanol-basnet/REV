# REV server configuration. Copy to server/.env and fill in. Never commit .env.

REV_HOST=127.0.0.1
REV_PORT=4600
REV_DATABASE_URL=./data/rev.db
REV_LOG_LEVEL=info

NAVIDROME_URL=http://localhost:4533
NAVIDROME_USERNAME=
NAVIDROME_PASSWORD=

LIDARR_URL=http://localhost:8686
LIDARR_API_KEY=
# Optional: where requested albums go and which profiles new artists get.
# Defaults: Lidarr's first accessible root folder and that folder's default profiles.
LIDARR_ROOT_FOLDER=
LIDARR_QUALITY_PROFILE_ID=
LIDARR_METADATA_PROFILE_ID=
# Also run Lidarr's own indexer search on request (Soularr acts on monitored albums either way).
LIDARR_SEARCH_ON_REQUEST=true

SLSKD_URL=http://localhost:5030
SLSKD_API_KEY=

# Lyrics providers, in priority order after REV's cache (navidrome, lrclib)
REV_LYRICS_PROVIDERS=navidrome,lrclib
LRCLIB_URL=https://lrclib.net

# Download tracking
REV_DOWNLOAD_POLL_SECONDS=15
REV_DOWNLOAD_TIMEOUT_HOURS=72
REV_INDEXING_TIMEOUT_HOURS=6

# LAN address Chromecasts use to fetch audio (enables casting), e.g. http://192.168.1.10:4600
# REV_CAST_BASE_URL=
